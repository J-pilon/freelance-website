<% content_for :title, "Startup Product Development: Blog | ClientFirst Labs" %>
<% content_for :meta_description, "Practical guides for early-stage startup founders on MVP development, startup product development, refactoring, and AI. Written by engineers who build startup products." %>

<div class="overflow-x-hidden text-gray-50 bg-background-black">
  <%= render partial: "shared/page/page_hero", locals: {
    label: "Blog",
    title: "Startup Product Development",
    description: "Practical guides for founders on building, shipping, and scaling startup products. No fluff. Just what we have learned from building real startup software."
  } %>

  <section class="!px-0 !py-0">
    <div class="mx-auto w-[min(1200px,calc(100%-48px))] py-20">
      <%= render partial: "shared/page/section_heading", locals: {
        label: "For the Builder Founder",
        title: "Building your first product"
      } %>

      <div class="grid grid-cols-1 gap-6 mt-10 sm:grid-cols-2 lg:grid-cols-3">
        <div class="p-6 bg-gray-800 rounded-xl border border-white/10">
          <span class="inline-block mb-3 font-mono text-[11px] tracking-[0.08em] uppercase text-gray-400">MVP Development</span>
          <h3 class="mb-3 text-[28px] leading-[1.15] tracking-normal">How to Build an MVP: A Founder's Guide</h3>
          <p class="mb-4 text-sm leading-[1.6] text-gray-300">What an MVP actually is, what it isn't, and how to scope one that validates your idea without wasting runway.</p>
          <span class="text-xs italic text-white/40">Coming soon</span>
        </div>

        <div class="p-6 bg-gray-800 rounded-xl border border-white/10">
          <span class="inline-block mb-3 font-mono text-[11px] tracking-[0.08em] uppercase text-gray-400">MVP Development</span>
          <h3 class="mb-3 text-[28px] leading-[1.15] tracking-normal">MVP vs Prototype: What's the Difference?</h3>
          <p class="mb-4 text-sm leading-[1.6] text-gray-300">The distinction matters for your timeline, your budget, and your investor conversations. Here's how to think about it.</p>
          <span class="text-xs italic text-white/40">Coming soon</span>
        </div>

        <div class="p-6 bg-gray-800 rounded-xl border border-white/10">
          <span class="inline-block mb-3 font-mono text-[11px] tracking-[0.08em] uppercase text-gray-400">Startup Product</span>
          <h3 class="mb-3 text-[28px] leading-[1.15] tracking-normal">Building a Startup Technical Roadmap</h3>
          <p class="mb-4 text-sm leading-[1.6] text-gray-300">How to plan your product roadmap when you don't have a full engineering team, and what to prioritize at each stage.</p>
          <span class="text-xs italic text-white/40">Coming soon</span>
        </div>
      </div>

      <div class="mt-8">
        <%= link_to "Learn about MVP development ->", mvp_development_path, class: "text-primary text-sm no-underline font-semibold hover:text-yellow-200" %>
      </div>
    </div>
  </section>

  <section class="!px-0 !py-0 bg-background-navy border-y border-white/10">
    <div class="mx-auto w-[min(1200px,calc(100%-48px))] py-20">
      <%= render partial: "shared/page/section_heading", locals: {
        label: "For the Technical Founder",
        title: "Scaling your startup codebase"
      } %>

      <div class="grid grid-cols-1 gap-6 mt-10 sm:grid-cols-2 lg:grid-cols-3">
        <div class="p-6 bg-gray-800 rounded-xl border border-white/10">
          <span class="inline-block mb-3 font-mono text-[11px] tracking-[0.08em] uppercase text-gray-400">Prototype to Production</span>
          <h3 class="mb-3 text-[28px] leading-[1.15] tracking-normal">When to Refactor Your MVP</h3>
          <p class="mb-4 text-sm leading-[1.6] text-gray-300">The five signals that tell you it's time to stop building on top of your prototype and invest in a clean foundation.</p>
          <span class="text-xs italic text-white/40">Coming soon</span>
        </div>

        <div class="p-6 bg-gray-800 rounded-xl border border-white/10">
          <span class="inline-block mb-3 font-mono text-[11px] tracking-[0.08em] uppercase text-gray-400">Startup Architecture</span>
          <h3 class="mb-3 text-[28px] leading-[1.15] tracking-normal">Scaling Startup Architecture: What Changes at Each Stage</h3>
          <p class="mb-4 text-sm leading-[1.6] text-gray-300">What your architecture should look like at pre-seed vs. seed vs. Series A, and how to avoid over-engineering early.</p>
          <span class="text-xs italic text-white/40">Coming soon</span>
        </div>

        <div class="p-6 bg-gray-800 rounded-xl border border-white/10">
          <span class="inline-block mb-3 font-mono text-[11px] tracking-[0.08em] uppercase text-gray-400">AI for Startups</span>
          <h3 class="mb-3 text-[28px] leading-[1.15] tracking-normal">Adding AI to Your Startup Product: Where to Start</h3>
          <p class="mb-4 text-sm leading-[1.6] text-gray-300">A practical framework for identifying which workflows and features in your product are worth automating or AI-powering first.</p>
          <span class="text-xs italic text-white/40">Coming soon</span>
        </div>
      </div>

      <div class="mt-8">
        <%= link_to "Learn about prototype to production ->", prototype_to_production_path, class: "text-primary text-sm no-underline font-semibold hover:text-yellow-200" %>
      </div>
    </div>
  </section>

  <section class="!px-0 !py-0">
    <div class="mx-auto w-[min(1200px,calc(100%-48px))] py-20">
      <%= render partial: "shared/page/section_heading", locals: {
        label: "Our services",
        title: "We build what we write about",
        centered: true
      } %>
      <div class="grid grid-cols-1 gap-6 mx-auto mt-10 w-full max-w-4xl sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col justify-between items-center p-6 text-center bg-gray-800 rounded-xl border border-white/10">
        <h5 class="mb-3 text-[22px] leading-[1.2] tracking-normal">MVP Development</h5>
        <%= link_to "Learn more ->", mvp_development_path, class: "text-primary text-sm no-underline font-semibold hover:text-yellow-200" %>
      </div>
      <div class="flex flex-col justify-between items-center p-6 text-center bg-gray-800 rounded-xl border border-white/10">
        <h5 class="mb-3 text-[22px] leading-[1.2] tracking-normal">Startup Product Development</h5>
        <%= link_to "Learn more ->", startup_product_development_path, class: "text-primary text-sm no-underline font-semibold hover:text-yellow-200" %>
      </div>
      <div class="flex flex-col justify-between items-center p-6 text-center bg-gray-800 rounded-xl border border-white/10">
        <h5 class="mb-3 text-[22px] leading-[1.2] tracking-normal">Prototype to Production</h5>
        <%= link_to "Learn more ->", prototype_to_production_path, class: "text-primary text-sm no-underline font-semibold hover:text-yellow-200" %>
      </div>
      <div class="flex flex-col justify-between items-center p-6 text-center bg-gray-800 rounded-xl border border-white/10">
        <h5 class="mb-3 text-[22px] leading-[1.2] tracking-normal">AI & Automation</h5>
        <%= link_to "Learn more ->", ai_automation_path, class: "text-primary text-sm no-underline font-semibold hover:text-yellow-200" %>
      </div>
    </div>
  </div>
  </section>

  <%= render partial: "shared/page/final_cta", locals: {
    label: "Book a founder call",
    title: "Building a startup product?",
    description: "Book a free 30-minute strategy call with a senior engineer who builds startup products.",
    cta_text: "Book a Founder Strategy Call",
    cta_url: "https://calendly.com/clientfirst-labs/discovery",
    helper_html: "Or #{link_to('go back to the homepage', root_path, class: 'text-primary no-underline hover:text-yellow-200')}"
  } %>
</div>
