<% content_for :title, "MVP Development for Startups | ClientFirst Labs" %>
<% content_for :meta_description, "ClientFirst Labs builds production-ready MVPs for early-stage startups. Go from idea to launch fast: scoped to validate, built to scale. Book a free founder call." %>

<div class="overflow-x-hidden text-gray-50 bg-background-navy">
  <%= render partial: "shared/page/page_hero", locals: {
    label: "MVP Development",
    title: "MVP Development for Startups",
    description: "Go from idea to a production-ready MVP without wasted time or over-engineered architecture. We scope, build, and ship around what you need to validate. Fast.",
    cta_text: "Book a Founder Strategy Call",
    cta_url: "https://calendly.com/clientfirst-labs/discovery"
  } %>

  <section class="!px-0 !py-0 bg-background-black">
    <div class="mx-auto w-[min(1200px,calc(100%-48px))] py-16">
      <div class="grid grid-cols-1 gap-6 w-full sm:grid-cols-3">
        <div class="p-6 bg-gray-800 rounded-xl border border-white/10">
          <p class="mb-1.5 text-[42px] font-normal leading-none text-secondary">8–16</p>
          <h3 class="mb-2 text-[28px] leading-[1.15] tracking-normal">Weeks to Launch</h3>
          <p class="text-sm leading-[1.6] text-gray-300">Most MVPs ship in 8–16 weeks. We scope to your validation goal, not an imaginary feature list.</p>
        </div>
        <div class="p-6 bg-gray-800 rounded-xl border border-white/10">
          <p class="mb-1.5 text-[42px] font-normal leading-none text-secondary">No</p>
          <h3 class="mb-2 text-[28px] leading-[1.15] tracking-normal">Outsourcing</h3>
          <p class="text-sm leading-[1.6] text-gray-300">Senior engineers build your product directly. No handoffs to junior contractors or offshore teams.</p>
        </div>
        <div class="p-6 bg-gray-800 rounded-xl border border-white/10">
          <p class="mb-1.5 text-[42px] font-normal leading-none text-secondary">Fixed</p>
          <h3 class="mb-2 text-[28px] leading-[1.15] tracking-normal">Scope Pricing</h3>
          <p class="text-sm leading-[1.6] text-gray-300">You know what you're getting before we start. No surprise invoices, no runaway billing.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="!px-0 !py-0 bg-background-navy border-y border-white/10">
    <div class="mx-auto w-[min(1200px,calc(100%-48px))] py-16">
      <div class="grid gap-16 md:grid-cols-2">
        <div>
          <%= render partial: "shared/page/section_heading", locals: { label: "Who this is for", title: "Builder founders who need to ship" } %>
          <p class="mb-6 leading-[1.7] text-gray-300">You have a validated idea (or you're close) and you need a technical partner to bring it to life. You're not looking for a dev shop that takes a brief and disappears. You need someone who thinks about your product like a co-founder.</p>
          <ul class="!m-0 !p-0 list-none space-y-3">
            <li class="!pl-0 text-sm text-gray-300">- Pre-seed and seed stage founders</li>
            <li class="!pl-0 text-sm text-gray-300">- Non-technical or semi-technical founders</li>
            <li class="!pl-0 text-sm text-gray-300">- Teams that need to show traction to investors</li>
            <li class="!pl-0 text-sm text-gray-300">- Founders replacing manual workflows with software</li>
          </ul>
        </div>

        <div>
          <%= render partial: "shared/page/section_heading", locals: { label: "What we build", title: "Production-ready MVPs, not prototypes" } %>
          <p class="mb-6 leading-[1.7] text-gray-300">We build software you can actually sell, demo, and scale. Not throwaway prototypes. Every MVP is scoped around your validation goal and built with a foundation that grows with your product.</p>
          <ul class="!m-0 !p-0 list-none space-y-3">
            <li class="!pl-0 text-sm text-gray-300">- SaaS web applications</li>
            <li class="!pl-0 text-sm text-gray-300">- Internal tools and dashboards</li>
            <li class="!pl-0 text-sm text-gray-300">- Customer-facing platforms</li>
            <li class="!pl-0 text-sm text-gray-300">- API integrations and automation</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="!px-0 !py-0 bg-background-black">
    <div class="mx-auto w-[min(1200px,calc(100%-48px))] py-16">
      <%= render partial: "shared/page/section_heading", locals: { label: "Our process", title: "How MVP development works", centered: true } %>
      <div class="grid grid-cols-1 gap-6 w-full sm:grid-cols-2 lg:grid-cols-4">
        <div class="p-6 bg-gray-800 rounded-xl border border-white/10">
          <p class="mb-2 text-[34px] font-normal leading-none text-secondary">01</p>
          <h3 class="mb-2 text-[24px] leading-[1.2] tracking-normal">Discovery Call</h3>
          <p class="text-sm leading-[1.6] text-gray-300">We learn your product, users, and goals. No sales pitch. Just an honest conversation about whether we're the right fit.</p>
        </div>
        <div class="p-6 bg-gray-800 rounded-xl border border-white/10">
          <p class="mb-2 text-[34px] font-normal leading-none text-secondary">02</p>
          <h3 class="mb-2 text-[24px] leading-[1.2] tracking-normal">Scoping & Estimate</h3>
          <p class="text-sm leading-[1.6] text-gray-300">We scope the MVP around your validation goal and give you a fixed-price estimate with a realistic timeline.</p>
        </div>
        <div class="p-6 bg-gray-800 rounded-xl border border-white/10">
          <p class="mb-2 text-[34px] font-normal leading-none text-secondary">03</p>
          <h3 class="mb-2 text-[24px] leading-[1.2] tracking-normal">Build & Iterate</h3>
          <p class="text-sm leading-[1.6] text-gray-300">Weekly demos, tight feedback loops, and iterative delivery. You see progress throughout, not just at the end.</p>
        </div>
        <div class="p-6 bg-gray-800 rounded-xl border border-white/10">
          <p class="mb-2 text-[34px] font-normal leading-none text-secondary">04</p>
          <h3 class="mb-2 text-[24px] leading-[1.2] tracking-normal">Launch</h3>
          <p class="text-sm leading-[1.6] text-gray-300">We ship to production and hand off a codebase you own: clean, documented, and built to grow.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="!px-0 !py-0 bg-background-navy border-y border-white/10">
    <div class="mx-auto w-[min(1200px,calc(100%-48px))] py-16">
      <%= render partial: "shared/page/section_heading", locals: { label: "Real outcome", title: "See it in action", centered: true } %>
      <div class="p-8 mx-auto mt-8 max-w-2xl bg-gray-800 rounded-xl border border-white/10">
        <p class="mb-4 leading-[1.7] text-gray-300">We helped Aspire, a Canadian InsurTech startup, go from manual operations to a full automation platform, eliminating 90% of manual work and unlocking $1M+ in revenue per agent.</p>
        <%= link_to "Read the Aspire case study ->", aspire_case_studies_path, class: "text-primary no-underline font-semibold hover:text-yellow-200" %>
      </div>
    </div>
  </section>

  <section class="!px-0 !py-0 bg-background-black">
    <div class="mx-auto w-[min(1200px,calc(100%-48px))] py-16">
      <%= render partial: "shared/page/section_heading", locals: { label: "Related services", title: "Where to go next", centered: true } %>
      <div class="grid grid-cols-1 gap-6 mx-auto w-full max-w-3xl sm:grid-cols-3">
        <div class="p-6 text-center bg-gray-800 rounded-xl border border-white/10">
          <h3 class="mb-3 text-[24px] leading-[1.2] tracking-normal">Prototype to Production</h3>
          <p class="mb-4 text-sm leading-[1.6] text-gray-300">Already have an early build? We clean it up and get it production-ready.</p>
          <%= link_to "Learn more ->", prototype_to_production_path, class: "text-primary text-sm no-underline font-semibold hover:text-yellow-200" %>
        </div>
        <div class="p-6 text-center bg-gray-800 rounded-xl border border-white/10">
          <h3 class="mb-3 text-[24px] leading-[1.2] tracking-normal">Startup Product Development</h3>
          <p class="mb-4 text-sm leading-[1.6] text-gray-300">Long-term product development partnership for scaling startups.</p>
          <%= link_to "Learn more ->", startup_product_development_path, class: "text-primary text-sm no-underline font-semibold hover:text-yellow-200" %>
        </div>
        <div class="p-6 text-center bg-gray-800 rounded-xl border border-white/10">
          <h3 class="mb-3 text-[24px] leading-[1.2] tracking-normal">AI & Automation</h3>
          <p class="mb-4 text-sm leading-[1.6] text-gray-300">Add AI-powered features and workflows to your startup product.</p>
          <%= link_to "Learn more ->", ai_automation_path, class: "text-primary text-sm no-underline font-semibold hover:text-yellow-200" %>
        </div>
      </div>
    </div>
  </section>

  <%= render partial: "shared/page/final_cta", locals: {
    label: "Book a founder call",
    title: "Ready to build your <em>MVP</em>?",
    description: "Book a free 30-minute strategy call. We will talk through your idea, your stage, and what it would take to ship.",
    cta_text: "Book a Founder Strategy Call",
    cta_url: "https://calendly.com/clientfirst-labs/discovery",
    helper_html: "Or #{link_to('go back to the homepage', root_path, class: 'text-primary no-underline hover:text-yellow-200')} · #{link_to('read the blog', blog_path, class: 'text-primary no-underline hover:text-yellow-200')}"
  } %>
</div>
