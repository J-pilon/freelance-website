<% content_for :title, "AI and Automation for Startups | ClientFirst Labs" %>
<% content_for :meta_description, "Add AI features and automation workflows to your startup product. ClientFirst Labs builds practical AI integrations and automation systems for early-stage Canadian startups." %>

<div class="overflow-x-hidden text-gray-50 bg-background-navy">
  <%= render partial: "shared/page/page_hero", locals: {
    label: "AI & Automation for Startups",
    title: "AI and Automation for Startups",
    description: "Add AI-powered features and automation workflows to your product: practical, scoped, and built to solve real founder problems. Not just a feature on a roadmap.",
    cta_text: "Book a Founder Strategy Call",
    cta_url: "https://calendly.com/clientfirst-labs/discovery"
  } %>

<section class="!px-0 !py-0 bg-background-black">
  <div class="mx-auto w-[min(1200px,calc(100%-48px))] py-16">
    <div class="grid grid-cols-1 gap-6 w-full sm:grid-cols-3">
      <div class="p-6 bg-gray-800 rounded-xl border border-white/10">
        <p class="mb-1.5 text-[42px] font-normal leading-none text-secondary">90%</p>
        <h3 class="mb-2 text-[28px] leading-[1.15] tracking-normal">Manual Work Eliminated</h3>
        <p class="text-sm leading-[1.6] text-gray-300">We helped Aspire automate 90% of repetitive agent workflows, replacing spreadsheets with a fully automated platform.</p>
      </div>
      <div class="p-6 bg-gray-800 rounded-xl border border-white/10">
        <p class="mb-1.5 text-[42px] font-normal leading-none text-secondary">Practical</p>
        <h3 class="mb-2 text-[28px] leading-[1.15] tracking-normal">AI, Not Hype</h3>
        <p class="text-sm leading-[1.6] text-gray-300">We build AI features that solve specific, measurable problems. Not demos that look impressive and deliver nothing.</p>
      </div>
      <div class="p-6 bg-gray-800 rounded-xl border border-white/10">
        <p class="mb-1.5 text-[42px] font-normal leading-none text-secondary">Fast</p>
        <h3 class="mb-2 text-[28px] leading-[1.15] tracking-normal">Time to Value</h3>
        <p class="text-sm leading-[1.6] text-gray-300">AI and automation projects are scoped tightly. We ship working automation before moving to the next layer.</p>
      </div>
    </div>
  </div>
</section>

<section class="!px-0 !py-0 bg-background-navy border-y border-white/10">
  <div class="mx-auto w-[min(1200px,calc(100%-48px))] py-16">
    <div class="grid gap-16 md:grid-cols-2">
      <div>
        <%= render partial: "shared/page/section_heading", locals: { label: "Who this is for", title: "Startups ready to automate the right things" } %>
        <p class="mb-6 leading-[1.7] text-gray-300">You're doing too much manually. You know some of it should be automated, or powered by AI, but you're not sure what to build, how to scope it, or where to start. We've done this before.</p>
        <ul class="!m-0 !p-0 list-none space-y-3">
          <li class="!pl-0 text-sm text-gray-300">- Founders running manual operations at scale</li>
          <li class="!pl-0 text-sm text-gray-300">- SaaS products that need AI-powered features</li>
          <li class="!pl-0 text-sm text-gray-300">- Startups replacing spreadsheets with internal tools</li>
          <li class="!pl-0 text-sm text-gray-300">- Technical founders who need engineering capacity for AI work</li>
        </ul>
      </div>

      <div>
        <%= render partial: "shared/page/section_heading", locals: { label: "What we build", title: "AI and automation that actually ships" } %>
        <p class="mb-6 leading-[1.7] text-gray-300">We build practical AI integrations and automation systems, not proof-of-concepts that never go to production.</p>
        <ul class="!m-0 !p-0 list-none space-y-3">
          <li class="!pl-0 text-sm text-gray-300">- LLM integrations (OpenAI, Claude, custom models)</li>
          <li class="!pl-0 text-sm text-gray-300">- Workflow automation and background job systems</li>
          <li class="!pl-0 text-sm text-gray-300">- AI-powered product features (search, summarization, generation)</li>
          <li class="!pl-0 text-sm text-gray-300">- Internal automation tools replacing manual processes</li>
          <li class="!pl-0 text-sm text-gray-300">- Third-party API and SaaS integrations</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="!px-0 !py-0 bg-background-black">
  <div class="mx-auto w-[min(1200px,calc(100%-48px))] py-16">
    <%= render partial: "shared/page/section_heading", locals: { label: "Real outcome", title: "Automation in practice", centered: true } %>
    <div class="p-8 mx-auto mt-8 max-w-2xl bg-gray-800 rounded-xl border border-white/10">
      <p class="mb-4 leading-[1.7] text-gray-300">We helped Aspire, a Canadian InsurTech startup, eliminate 90% of manual agent workflows through end-to-end automation, saving $100K/year in operational overhead and unlocking $1M+ in revenue per agent.</p>
      <%= link_to "Read the Aspire case study ->", aspire_case_studies_path, class: "text-primary no-underline font-semibold hover:text-yellow-200" %>
    </div>
  </div>
</section>

<section class="!px-0 !py-0 bg-background-navy border-y border-white/10">
  <div class="mx-auto w-[min(1200px,calc(100%-48px))] py-16">
    <%= render partial: "shared/page/section_heading", locals: { label: "Related services", title: "Where to go next", centered: true } %>
    <div class="grid grid-cols-1 gap-6 mx-auto w-full max-w-3xl sm:grid-cols-3">
      <div class="p-6 text-center bg-gray-800 rounded-xl border border-white/10">
        <h3 class="mb-3 text-[24px] leading-[1.2] tracking-normal">MVP Development</h3>
        <p class="mb-4 text-sm leading-[1.6] text-gray-300">Build your product from scratch, with AI baked in from day one.</p>
        <%= link_to "Learn more ->", mvp_development_path, class: "text-primary text-sm no-underline font-semibold hover:text-yellow-200" %>
      </div>
      <div class="p-6 text-center bg-gray-800 rounded-xl border border-white/10">
        <h3 class="mb-3 text-[24px] leading-[1.2] tracking-normal">Startup Product Development</h3>
        <p class="mb-4 text-sm leading-[1.6] text-gray-300">Ongoing product development including AI feature work.</p>
        <%= link_to "Learn more ->", startup_product_development_path, class: "text-primary text-sm no-underline font-semibold hover:text-yellow-200" %>
      </div>
      <div class="p-6 text-center bg-gray-800 rounded-xl border border-white/10">
        <h3 class="mb-3 text-[24px] leading-[1.2] tracking-normal">Prototype to Production</h3>
        <p class="mb-4 text-sm leading-[1.6] text-gray-300">Clean up your codebase before adding AI and automation layers.</p>
        <%= link_to "Learn more ->", prototype_to_production_path, class: "text-primary text-sm no-underline font-semibold hover:text-yellow-200" %>
      </div>
    </div>
  </div>
</section>

<%= render partial: "shared/page/final_cta", locals: {
  label: "Book a founder call",
  title: "Ready to automate the right things?",
  description: "Book a free 30-minute strategy call. We will talk through your workflows, your product, and what is worth automating first.",
  cta_text: "Book a Founder Strategy Call",
  cta_url: "https://calendly.com/clientfirst-labs/discovery",
  helper_html: "Or #{link_to('go back to the homepage', root_path, class: 'text-primary no-underline hover:text-yellow-200')} · #{link_to('read the blog', blog_path, class: 'text-primary no-underline hover:text-yellow-200')}"
} %>
</div>
