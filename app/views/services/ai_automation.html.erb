<% content_for :title, "AI and Automation for Startups | ClientFirst Labs" %>
<% content_for :meta_description, "Add AI features and automation workflows to your startup product. ClientFirst Labs builds practical AI integrations and automation systems for early-stage Canadian startups." %>

<section class="flex items-center justify-center min-h-[60vh] px-4 py-20 bg-background-navy md:px-8">
  <div class="w-full content-container">
    <div class="max-w-3xl">
      <div class="mb-6 pill w-fit">
        <p>AI & Automation for Startups</p>
      </div>
      <h1 class="mb-6 text-4xl font-bold leading-tight text-white sm:text-5xl">AI and Automation for Startups</h1>
      <p class="mb-8 text-lg text-white/80">Add AI-powered features and automation workflows to your product — practical, scoped, and built to solve real founder problems. Not just a feature on a roadmap.</p>
      <div class="flex justify-start mt-8"><%= link_to "Book a Founder Strategy Call", "https://calendly.com/clientfirst-labs/discovery", class: "btn-primary btn-lg hover:text-gray-800" %></div>
    </div>
  </div>
</section>

<section class="px-4 py-16 bg-background-black md:px-8">
  <div class="content-container">
    <div class="grid grid-cols-1 gap-6 w-full sm:grid-cols-3">
      <div class="p-6 rounded-xl bg-white/5">
        <p class="mb-2 text-3xl font-bold text-secondary">90%</p>
        <h3 class="mb-2 text-lg font-semibold text-white">Manual Work Eliminated</h3>
        <p class="text-sm text-white/70">We helped Aspire automate 90% of repetitive agent workflows — replacing spreadsheets with a fully automated platform.</p>
      </div>
      <div class="p-6 rounded-xl bg-white/5">
        <p class="mb-2 text-3xl font-bold text-secondary">Practical</p>
        <h3 class="mb-2 text-lg font-semibold text-white">AI, Not Hype</h3>
        <p class="text-sm text-white/70">We build AI features that solve specific, measurable problems — not demos that look impressive and deliver nothing.</p>
      </div>
      <div class="p-6 rounded-xl bg-white/5">
        <p class="mb-2 text-3xl font-bold text-secondary">Fast</p>
        <h3 class="mb-2 text-lg font-semibold text-white">Time to Value</h3>
        <p class="text-sm text-white/70">AI and automation projects are scoped tightly. We ship working automation before moving to the next layer.</p>
      </div>
    </div>
  </div>
</section>

<section class="px-4 py-16 bg-background-navy md:px-8">
  <div class="content-container">
    <div class="grid gap-16 md:grid-cols-2">
      <div>
        <div class="mb-6 pill w-fit">
          <p>Who this is for</p>
        </div>
        <h2 class="mb-4 text-2xl font-bold text-white">Startups ready to automate the right things</h2>
        <p class="mb-6 text-white/80">You're doing too much manually. You know some of it should be automated, or powered by AI — but you're not sure what to build, how to scope it, or where to start. We've done this before.</p>
        <ul class="space-y-3 text-white/80">
          <li>→ Founders running manual operations at scale</li>
          <li>→ SaaS products that need AI-powered features</li>
          <li>→ Startups replacing spreadsheets with internal tools</li>
          <li>→ Technical founders who need engineering capacity for AI work</li>
        </ul>
      </div>

      <div>
        <div class="mb-6 pill w-fit">
          <p>What we build</p>
        </div>
        <h2 class="mb-4 text-2xl font-bold text-white">AI and automation that actually ships</h2>
        <p class="mb-6 text-white/80">We build practical AI integrations and automation systems — not proof-of-concepts that never go to production.</p>
        <ul class="space-y-3 text-white/80">
          <li>→ LLM integrations (OpenAI, Claude, custom models)</li>
          <li>→ Workflow automation and background job systems</li>
          <li>→ AI-powered product features (search, summarization, generation)</li>
          <li>→ Internal automation tools replacing manual processes</li>
          <li>→ Third-party API and SaaS integrations</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="px-4 py-16 bg-background-black md:px-8">
  <div class="content-container">
    <div class="mx-auto mb-16 pill w-fit">
      <p>Real outcome</p>
    </div>
    <h2 class="mb-8 text-2xl font-bold text-center text-white sm:text-3xl">Automation in practice</h2>
    <div class="p-8 mx-auto max-w-2xl rounded-xl bg-white/5">
      <p class="mb-4 text-white/80">We helped Aspire, a Canadian InsurTech startup, eliminate 90% of manual agent workflows through end-to-end automation — saving $100K/year in operational overhead and unlocking $1M+ in revenue per agent.</p>
      <%= link_to "Read the Aspire case study →", aspire_case_studies_path, class: "text-primary font-medium" %>
    </div>
  </div>
</section>

<section class="px-4 py-16 bg-background-navy md:px-8">
  <div class="content-container">
    <div class="mx-auto mb-8 pill w-fit">
      <p>Related services</p>
    </div>
    <div class="grid grid-cols-1 gap-6 mx-auto w-full max-w-3xl sm:grid-cols-3">
      <div class="p-6 text-center rounded-xl bg-white/5">
        <h3 class="mb-3 font-semibold text-white">MVP Development</h3>
        <p class="mb-4 text-sm text-white/70">Build your product from scratch — with AI baked in from day one.</p>
        <%= link_to "Learn more →", mvp_development_path, class: "text-primary text-sm font-medium" %>
      </div>
      <div class="p-6 text-center rounded-xl bg-white/5">
        <h3 class="mb-3 font-semibold text-white">Startup Product Development</h3>
        <p class="mb-4 text-sm text-white/70">Ongoing product development including AI feature work.</p>
        <%= link_to "Learn more →", startup_product_development_path, class: "text-primary text-sm font-medium" %>
      </div>
      <div class="p-6 text-center rounded-xl bg-white/5">
        <h3 class="mb-3 font-semibold text-white">Prototype to Production</h3>
        <p class="mb-4 text-sm text-white/70">Clean up your codebase before adding AI and automation layers.</p>
        <%= link_to "Learn more →", prototype_to_production_path, class: "text-primary text-sm font-medium" %>
      </div>
    </div>
  </div>
</section>

<section class="px-4 py-16 bg-background-black md:px-8">
  <div class="flex flex-col items-center content-container">
    <h2 class="mb-4 max-w-xl text-2xl font-bold text-center text-white sm:text-3xl">Ready to automate the right things?</h2>
    <p class="mb-8 max-w-lg text-base text-center text-white/80">Book a free 30-minute strategy call. We'll talk through your workflows, your product, and what's worth automating first.</p>
    <%= link_to "Book a Founder Strategy Call", "https://calendly.com/clientfirst-labs/discovery", class: "btn-primary btn-lg hover:text-gray-800" %>
    <p class="mt-6 text-sm text-white/50">Or <%= link_to "go back to the homepage", root_path, class: "text-primary" %></p>
  </div>
</section>
