<% content_for :title, "Startup Product Development | ClientFirst Labs" %>
<% content_for :meta_description, "Long-term startup product development and SaaS development for early-stage Canadian startups. Senior engineers who work as your technical partner." %>

<section class="flex items-center justify-center min-h-[60vh] px-4 py-20 bg-background-navy md:px-8">
  <div class="w-full content-container">
    <div class="max-w-3xl">
      <div class="mb-6 pill w-fit">
        <p>Startup Product Development</p>
      </div>
      <h1 class="mb-6 text-4xl font-bold leading-tight text-white sm:text-5xl">Startup Product Development</h1>
      <p class="mb-8 text-lg text-white/80">Build your SaaS product with a technical partner who moves at startup speed. Senior engineers, direct communication, and an engineering culture built around your growth stage.</p>
      <div class="flex justify-start mt-8"><%= link_to "Book a Founder Strategy Call", "https://calendly.com/clientfirst-labs/discovery", class: "btn-primary btn-lg hover:text-gray-800" %></div>
    </div>
  </div>
</section>

<section class="px-4 py-16 bg-background-black md:px-8">
  <div class="content-container">
    <div class="grid grid-cols-1 gap-6 w-full sm:grid-cols-3">
      <div class="p-6 rounded-xl bg-white/5">
        <p class="mb-2 text-3xl font-bold text-secondary">Senior</p>
        <h3 class="mb-2 text-lg font-semibold text-white">Engineers Only</h3>
        <p class="text-sm text-white/70">You work directly with the senior engineer building your product — no project manager middlemen, no juniors.</p>
      </div>
      <div class="p-6 rounded-xl bg-white/5">
        <p class="mb-2 text-3xl font-bold text-secondary">Full</p>
        <h3 class="mb-2 text-lg font-semibold text-white">Stack Coverage</h3>
        <p class="text-sm text-white/70">Web, mobile, API, DevOps, integrations. We handle the full technical surface of your product.</p>
      </div>
      <div class="p-6 rounded-xl bg-white/5">
        <p class="mb-2 text-3xl font-bold text-secondary">Flexible</p>
        <h3 class="mb-2 text-lg font-semibold text-white">Engagement Models</h3>
        <p class="text-sm text-white/70">Project-based or ongoing retainer. Structured around your runway, not our billing preferences.</p>
      </div>
    </div>
  </div>
</section>

<section class="px-4 py-16 bg-background-navy md:px-8">
  <div class="content-container">
    <div class="grid gap-16 md:grid-cols-2">
      <div>
        <div class="mb-6 pill w-fit">
          <p>Who this is for</p>
        </div>
        <h2 class="mb-4 text-2xl font-bold text-white">Startups building serious products</h2>
        <p class="mb-6 text-white/80">You've validated your idea and now you need to build and iterate fast. You need a technical partner embedded in your product — not a freelancer picking up tickets, and not an agency that throws headcount at the problem.</p>
        <ul class="space-y-3 text-white/80">
          <li>→ Seed to Series A startups</li>
          <li>→ SaaS products needing ongoing development</li>
          <li>→ Founders who want an engineering partner, not a vendor</li>
          <li>→ Teams preparing for investor demos or customer launches</li>
        </ul>
      </div>

      <div>
        <div class="mb-6 pill w-fit">
          <p>What's included</p>
        </div>
        <h2 class="mb-4 text-2xl font-bold text-white">End-to-end product engineering</h2>
        <p class="mb-6 text-white/80">We take ownership of the full engineering function so your founding team can focus on sales, fundraising, and customers — not managing developers.</p>
        <ul class="space-y-3 text-white/80">
          <li>→ Feature development and iteration</li>
          <li>→ Architecture decisions and technical direction</li>
          <li>→ Third-party integrations (Stripe, APIs, SaaS tools)</li>
          <li>→ DevOps, CI/CD, and deployment</li>
          <li>→ Performance and scalability work</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="px-4 py-16 bg-background-black md:px-8">
  <div class="content-container">
    <div class="mx-auto mb-16 pill w-fit">
      <p>Tech stack</p>
    </div>
    <h2 class="mb-12 text-2xl font-bold text-center text-white sm:text-3xl">Built for startup pragmatism</h2>
    <div class="grid grid-cols-2 gap-3 mx-auto max-w-2xl sm:grid-cols-4">
      <div class="flex justify-center items-center p-4 rounded-xl bg-white/5">
        <span class="text-sm font-medium text-white">Ruby on Rails</span>
      </div>
      <div class="flex justify-center items-center p-4 rounded-xl bg-white/5">
        <span class="text-sm font-medium text-white">React / Hotwire</span>
      </div>
      <div class="flex justify-center items-center p-4 rounded-xl bg-white/5">
        <span class="text-sm font-medium text-white">PostgreSQL</span>
      </div>
      <div class="flex justify-center items-center p-4 rounded-xl bg-white/5">
        <span class="text-sm font-medium text-white">AWS</span>
      </div>
      <div class="flex justify-center items-center p-4 rounded-xl bg-white/5">
        <span class="text-sm font-medium text-white">Stripe</span>
      </div>
      <div class="flex justify-center items-center p-4 rounded-xl bg-white/5">
        <span class="text-sm font-medium text-white">OpenAI / LLMs</span>
      </div>
      <div class="flex justify-center items-center p-4 rounded-xl bg-white/5">
        <span class="text-sm font-medium text-white">React Native</span>
      </div>
      <div class="flex justify-center items-center p-4 rounded-xl bg-white/5">
        <span class="text-sm font-medium text-white">CI/CD Pipelines</span>
      </div>
    </div>
  </div>
</section>

<section class="px-4 py-16 bg-background-navy md:px-8">
  <div class="content-container">
    <div class="mx-auto mb-12 pill w-fit">
      <p>Real outcome</p>
    </div>
    <h2 class="mb-8 text-2xl font-bold text-center text-white sm:text-3xl">See it in action</h2>
    <div class="p-8 mx-auto max-w-2xl rounded-xl bg-white/5">
      <p class="mb-4 text-white/80">We took full product ownership for Wecasa — a Canadian co-ownership startup — building their booking platform, self-serve onboarding, and DevOps foundation. Result: 60% fewer support tickets and faster iteration cycles.</p>
      <%= link_to "Read the Wecasa case study →", wecasa_case_studies_path, class: "text-primary font-medium" %>
    </div>
  </div>
</section>

<section class="px-4 py-16 bg-background-black md:px-8">
  <div class="content-container">
    <div class="mx-auto mb-8 pill w-fit">
      <p>Related services</p>
    </div>
    <div class="grid grid-cols-1 gap-6 mx-auto w-full max-w-3xl sm:grid-cols-3">
      <div class="p-6 text-center rounded-xl bg-white/5">
        <h3 class="mb-3 font-semibold text-white">MVP Development</h3>
        <p class="mb-4 text-sm text-white/70">Need to go from zero to a working product first?</p>
        <%= link_to "Learn more →", mvp_development_path, class: "text-primary text-sm font-medium" %>
      </div>
      <div class="p-6 text-center rounded-xl bg-white/5">
        <h3 class="mb-3 font-semibold text-white">Prototype to Production</h3>
        <p class="mb-4 text-sm text-white/70">Refactor an existing codebase into a scalable foundation.</p>
        <%= link_to "Learn more →", prototype_to_production_path, class: "text-primary text-sm font-medium" %>
      </div>
      <div class="p-6 text-center rounded-xl bg-white/5">
        <h3 class="mb-3 font-semibold text-white">AI & Automation</h3>
        <p class="mb-4 text-sm text-white/70">Add AI features and automation workflows to your product.</p>
        <%= link_to "Learn more →", ai_automation_path, class: "text-primary text-sm font-medium" %>
      </div>
    </div>
  </div>
</section>

<section class="px-4 py-16 bg-background-navy md:px-8">
  <div class="flex flex-col items-center content-container">
    <h2 class="mb-4 max-w-xl text-2xl font-bold text-center text-white sm:text-3xl">Ready to build your startup product?</h2>
    <p class="mb-8 max-w-lg text-base text-center text-white/80">Book a free 30-minute strategy call. We'll talk through your product, your stage, and how we can move fast together.</p>
    <%= link_to "Book a Founder Strategy Call", "https://calendly.com/clientfirst-labs/discovery", class: "btn-primary btn-lg hover:text-gray-800" %>
    <p class="mt-6 text-sm text-white/50">Or <%= link_to "go back to the homepage", root_path, class: "text-primary" %> · <%= link_to "read the blog", blog_path, class: "text-primary" %></p>
  </div>
</section>
