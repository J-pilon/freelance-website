<section class="flex justify-center items-center px-4 py-12 min-h-screen bg-background-navy md:px-8">
  <div class="flex flex-col gap-8 justify-center items-center w-full h-full content-container lg:flex-row">
    <div class="space-y-6 w-full text-center lg:w-full lg:text-left">
      <h1 class="text-3xl font-bold leading-tight sm:text-4xl md:text-5xl">Your local software <strong class="text-secondary">experts</strong> that deliver results</h1>
      <p class="text-base text-white sm:text-lg">Our unique approach to software development focuses on understanding your concerns and presenting data to back up your decisions, ensuring that our custom software solutions meet and exceed your business objectives.</p>
    </div>
    <div class="flex justify-center w-full">
      <%= image_tag("icons/swoosh.svg", class: "") %>
    </div>
  </div>
</section>

<section class="px-4 py-16 bg-background-black md:px-8">
  <div class="flex flex-col items-center content-container">
    <div class="mb-16 pill">
      <p class="">What we stand for</p>
    </div>

    <div class="flex flex-col items-start md:flex-row md:justify-between md:gap-16">
      <div class="mb-8 w-full md:w-1/2 md:mb-0">
        <%= image_tag("Josiah-March2024-8-M.jpg", class: "rounded-xl shadow-lg w-full h-auto") %>
      </div>

      <div class="space-y-10 w-full md:w-1/2">
        <div class="text-center md:text-left">
          <h3 class="">Client-Focused Approach</h3>
          <p class="">Your goals drive our roadmap. We listen before we build, and we adapt as your needs evolve. We don't chase trends—we focus on what moves your business forward. Every decision, from UX to infrastructure, is made with your success in mind.</p>
        </div>

        <div class="text-center md:text-left">
          <h3 class="">Product-First Thinking</h3>
          <p class="">We focus on what your users are really trying to accomplish and build features that move the needle. Whether it’s automating repetitive processes, optimizing critical workflows, or refining key user interactions, we care deeply about the “why” behind every feature. That lens leads to software that’s not only functional, but intuitive, impactful, and—most importantly—used.</p>
        </div>
        
        <div class="text-center md:text-left">
          <h3 class="">On Budget, On Purpose</h3>
          <p class="">We treat your budget like it’s our own. From day one, we prioritize the features that deliver the most value and avoid scope creep disguised as “nice-to-haves.” Our process is transparent, and our estimates are grounded in real experience—so you’re never caught off guard. Predictable spend, no surprises.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="px-4 py-16 bg-background-navy md:px-8">
  <div class="flex flex-col items-center content-container">
    <div class="mb-16 pill">
      <p class="">What we do</p>
    </div>

    <div class="flex-col space-y-16 w-full">
      <%= render partial: "shared/service-card", locals: {
        reverse: false,
        image_src: asset_path("web-application-dev.jpg"),
        heading: "Web Application Design & Development",
        description: "Transform your startup’s vision into a robust and scalable web application with ClientFirst Labs. Our team specializes in creating user-friendly, high-performance web applications tailored to meet your business needs. Benefit from our expertise in the latest technologies to ensure your application is secure, maintainable, and ready for future growth."
      } %>

      <%= render partial: "shared/service-card", locals: {
        reverse: true,
        image_src: asset_path("mobile-dev.jpg"),
        heading: "Mobile Application Design & Development",
        description: "Enhance your startup’s reach with custom mobile applications designed and developed by ClientFirst Labs. We deliver seamless, intuitive mobile experiences that engage users and drive business growth. Whether it's for iOS or Android, our solutions are optimized for performance and usability, ensuring your app stands out in a competitive market."
      } %>
      
      <%= render partial: "shared/service-card", locals: {
        reverse: false,
        image_src: asset_path("modernization.webp"),
        heading: "Website Modernization",
        description: "Give your startup a competitive edge with a modernized website from ClientFirst Labs. We revamp outdated websites to improve aesthetics, functionality, and user experience, making your business more appealing and accessible to customers. Modernize your online presence to boost engagement, enhance SEO, and increase conversion rates."
      } %>

      <%= render partial: "shared/service-card", locals: {
        reverse: true,
        image_src: asset_path("modernization.webp"),
        heading: "Staff Augmentation",
        description: "Done-With-You Feature Delivery for Overcapacity Agencies. We embed a senior engineer into your stack (React, Rails, iOS, or Python) in under 48 hours. You get a product-minded developer with proven agency experience, providing daily async updates and requiring zero micromanagement. Our focus is always on MVP impact, not building unnecessary features, and you can scale our involvement up or down as needed. We guarantee bug-free delivery, fixing any issues at no extra cost. Multiply your staff's efforts and ship faster—without the overhead of hiring more employees."
      } %>
    </div>
  </div>
</section>

<section class="px-4 py-16 bg-background-black md:px-8">
  <div class="flex flex-col items-center content-container">
    <div class="mb-16 pill">
      <p class="">Our work</p>
    </div>
    
    <div class="flex flex-col items-center space-y-16 md:hidden">
      <div class="flex flex-col justify-center items-center w-full md:gap-8 md:flex-row">
        <div class="flex justify-center mb-4 w-full md:mb-0">
          <%= image_tag("aspire/case-study-home.png", class: "max-w-[500px]") %>
        </div>

        <div class="w-full">
          <div class="w-full">
            <h2 class="text-4xl text-center text-white md:text-left">Aspire</h2>
            <p class="mt-4 w-full text-3xl text-center md:w-4/5 md:text-left">Empowering Insurance Agents with a Breakthrough Digital</p>
          </div>

          <div class="flex justify-center mt-16 w-full md:justify-start">
            <%= link_to "View case study", aspire_case_studies_path, class: "text-xl text-primary" %>
          </div>
        </div>
      </div>

      <div class="flex flex-col justify-center items-center w-full md:gap-8 md:flex-row">
        <div class="flex justify-center mb-4 w-full md:mb-0">
          <%= image_tag("wecasa/case-study-home.png", class: "max-w-[500px]") %>
        </div>

        <div class="w-full">
          <div class="w-full">
            <h2 class="text-4xl text-center text-white md:text-left">Wecasa</h2>
            <p class="mt-4 w-full text-3xl text-center md:w-4/5 md:text-left">Creating a Web and Mobile Platform to Simplify Second Home Management</p>
          </div>

          <div class="flex justify-center mt-16 w-full md:justify-start">
            <%= link_to "View case study", "", class: "text-xl text-primary" %>
          </div>
        </div>
      </div>
    </div>

    <div data-controller="carousel"
      data-carousel-autoplay-value="false"
      data-carousel-interval-value="5000"
      class="hidden overflow-hidden relative mx-auto w-full max-w-5xl rounded-xl md:block">

      <div class="relative">
        <div data-carousel-target="slide" class="flex items-center justify-center hidden w-full text-2xl font-bold text-white bg-transparent h-[420px]">
          <div class="flex flex-col justify-center items-center w-full md:gap-8 md:flex-row">
            <div class="flex justify-center mb-4 w-full md:mb-0">
              <%= image_tag("aspire/case-study-home.png", class: "max-w-[500px]") %>
            </div>

            <div class="w-full">
              <div class="w-full">
                <h2 class="text-4xl text-center text-white md:text-left">Aspire</h2>
                <p class="mt-4 w-full text-3xl text-center md:w-3/4 md:text-left">Empowering Insurance Agents with a Breakthrough Digital</p>
              </div>

              <div class="flex justify-center mt-16 w-full md:justify-start">
                <%= link_to "View case study", aspire_case_studies_path, class: "text-xl text-primary" %>
              </div>
            </div>
          </div>
        </div>

        <div data-carousel-target="slide" class="flex items-center justify-center hidden w-full text-2xl font-bold text-white bg-transparent h-[420px]">
          <div class="flex flex-col justify-center items-center w-full md:gap-8 md:flex-row">
            <div class="flex justify-center mb-4 w-full md:mb-0">
              <%= image_tag("wecasa/case-study-home.png", class: "max-w-[500px]") %>
            </div>

            <div class="w-full">
              <div class="w-full">
                <h2 class="text-4xl text-center text-white md:text-left">Wecasa</h2>
                <p class="mt-4 w-full text-3xl text-center md:w-3/4 md:text-left">Making Luxury Vacation Homes Truly Shareable</p>
              </div>

              <div class="flex justify-center mt-16 w-full md:justify-start">
                <%= link_to "View case study", wecasa_case_studies_path, class: "text-xl text-primary" %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <button data-action="click->carousel#previous"
        class="absolute left-4 top-1/2 p-2 rounded-full transition -translate-y-1/2 text-primary bg-white/50 hover:bg-white">
        ◀
      </button>

      <button data-action="click->carousel#next"
        class="absolute right-4 top-1/2 p-2 rounded-full transition -translate-y-1/2 text-primary bg-white/50 hover:bg-white">
        ▶
      </button>
  </div>
</section>

<section class="px-4 py-16 bg-background-navy md:px-8">
  <div class="flex flex-col items-center content-container">
    <div class="mb-16 pill">
