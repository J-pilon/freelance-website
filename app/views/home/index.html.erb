      <%= render partial: "shared/service-card", locals: {
        reverse: true,
        image_src: asset_path("mobile-dev.jpg"),
        heading: "Mobile App Development",
        description: "Build a startup-grade iOS or Android app designed around user retention and product-market fit. We handle the full build — from UX through deployment — so you can focus on growth instead of managing a complex mobile codebase. Optimized for performance, built to iterate quickly as your product evolves."
