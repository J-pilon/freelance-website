<section class="!px-0 !py-0 text-center border-y border-white/10 bg-[linear-gradient(180deg,rgba(255,215,1,0.06),rgba(173,216,230,0.04))]">
  <div class="mx-auto w-[min(1200px,calc(100%-48px))] py-24">
    <p class="mb-4 font-mono text-[11px] tracking-[0.12em] uppercase text-gray-50"><%= label %></p>
    <h2 class="mb-4 text-[clamp(38px,5vw,64px)] leading-[1.08] font-normal tracking-normal"><%= title.html_safe %></h2>
    <p class="max-w-[700px] mx-auto mb-6 text-lg font-light leading-[1.65] text-gray-300"><%= description %></p>
    <div class="flex flex-wrap gap-3.5 justify-center">
      <%= link_to cta_text, cta_url, class: "inline-block rounded-md border border-transparent bg-primary px-6 py-3.5 text-sm font-semibold text-gray-900 no-underline shadow-[0_0_6px_1px_#ffd701] transition duration-200 hover:-translate-y-px hover:opacity-90" %>
      <% if local_assigns[:secondary_text].present? %>
        <%= link_to secondary_text, secondary_url, class: "inline-block px-6 py-3.5 text-sm font-semibold text-gray-300 no-underline transition duration-200 border rounded-md border-white/10 hover:border-secondary hover:text-gray-50" %>
      <% end %>
    </div>
    <% if local_assigns[:helper_html].present? %>
      <p class="mt-6 text-sm text-gray-400"><%= helper_html.html_safe %></p>
    <% end %>
  </div>
</section>
