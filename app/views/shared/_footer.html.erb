<footer class="!px-0 !py-0 bg-background-black">
  <div class="mx-auto w-[min(1200px,calc(100%-48px))] grid gap-5 py-10 md:[grid-template-columns:1.1fr_1fr_1fr]">
    <div>
      <h4 class="text-lg font-bold text-white no-underline transition-colors hover:text-primary">ClientFirst Labs</h4>
      <p class="leading-[1.6] text-gray-300">Startup software development partner for Canadian founders building MVPs and production products.</p>
      <p class="mt-2.5 text-[13px] text-gray-400">Vancouver, BC · Canada</p>
    </div>
    
    <div>
      <h4 class="mb-3 font-mono text-[11px] tracking-[0.1em] uppercase text-gray-400">Services</h4>
      <%= link_to "MVP Development", mvp_development_path, class: "block mb-2 text-sm text-gray-300 no-underline hover:text-primary" %>
      <%= link_to "Product Development", startup_product_development_path, class: "block mb-2 text-sm text-gray-300 no-underline hover:text-primary" %>
      <%= link_to "Mobile Development", mobile_development_path, class: "block mb-2 text-sm text-gray-300 no-underline hover:text-primary" %>
      <%= link_to "Prototype to Production", prototype_to_production_path, class: "block mb-2 text-sm text-gray-300 no-underline hover:text-primary" %>
      <%= link_to "AI & Automation", ai_automation_path, class: "block mb-2 text-sm text-gray-300 no-underline hover:text-primary" %>
    </div>

    <div>
      <h4 class="mb-3 font-mono text-[11px] tracking-[0.1em] uppercase text-gray-400">Get In Touch</h4>
      <%= link_to "josiah@clientfirstlabs.io", "mailto:josiah@clientfirstlabs.io", class: "block mb-2 text-sm text-gray-300 no-underline hover:text-primary" %>
      <%= link_to "+1 (778) 344-4798", "tel:+17783444798", class: "block mb-2 text-sm text-gray-300 no-underline hover:text-primary" %>
      <%= link_to "Book a Strategy Call", "https://calendly.com/clientfirst-labs/discovery", class: "block mb-2 text-sm text-gray-300 no-underline hover:text-primary" %>
    </div>
  </div>
</footer>
